{
  "name": "@mathlabs/mathra",
  "version": "1.9.1",
  "description": "Math LaTeX to accessible SVG, without a TeX install: equations, chemistry (chemfig) and commutative diagrams. Speech for screen readers in 16 languages and braille. Runs on WebAssembly in Node, bundlers and browsers.",
  "keywords": [
    "latex",
    "math",
    "equations",
    "svg",
    "accessibility",
    "screen-reader",
    "typesetting",
    "webassembly",
    "i18n",
    "localization",
    "chemistry",
    "chemfig",
    "mhchem",
    "tikz-cd",
    "braille",
    "katex-alternative",
    "mathjax-alternative",
    "rust",
    "python",
    "cli",
    "javascript",
    "typescript"
  ],
  "homepage": "https://matheusmota-dev-br.github.io/mathra/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheusmota-dev-br/mathra.git",
    "directory": "npm"
  },
  "bugs": "https://github.com/matheusmota-dev-br/mathra/issues",
  "funding": "https://github.com/sponsors/matheusmota-dev-br",
  "license": "(MIT OR Apache-2.0) AND OFL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./index.d.ts",
          "default": "./node/index.mjs"
        },
        "require": {
          "types": "./index.d.cts",
          "default": "./node/index.cjs"
        }
      },
      "default": {
        "types": "./index.d.ts",
        "default": "./web/index.js"
      }
    },
    "./mathra.wasm": "./mathra.wasm",
    "./package.json": "./package.json"
  },
  "main": "./node/index.cjs",
  "module": "./web/index.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "web",
    "node",
    "mathra.wasm",
    "index.d.ts",
    "index.d.cts",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "OFL-STIXTwoMath.txt"
  ]
}